# setup creates .env automatically. Keep real keys in .env, never in Git.
# 安装自动创建 .env；密钥只填 .env，不要修改或提交本示例。
# Narration / 配音：自己的 MiniMax Key 与账号可用的音色。
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=male-qn-jingying
# Optional region / 默认中国区；海外账号填写 https://api.minimax.io，当前中国区地址也可填 https://api.minimax.cn。
# MINIMAX_API_HOST=https://api.minimaxi.com

# Optional word timing / 需要备用字幕识别或有旁白片头取时间时，填 VideoCaptioner 目录。
VIDEO_CAPTIONER_ROOT=

# Optional evidence lookup / 仅在 TypeSafe 出处定位时需要。
# TYPESAFE_API_KEY=

# Optional personal music / 可选个人默认配乐：音频放忽略目录，不配置则无正文配乐。
# BACKGROUND_MUSIC_FILE=local-media/background-music/local.mp3
# BACKGROUND_MUSIC_SOURCE=曲名、作者及许可来源
# BACKGROUND_MUSIC_RIGHTS=licensed

# Optional tool paths / 通常无需修改；相对路径以本仓库根目录为准。
# XIAOXINXIXN_PYTHON=.venv/bin/python
# VIDEO_CAPTIONER_PYTHON=/工具目录/.venv/bin/python
# NLM_BIN=.venv/bin/nlm
# DREAMINA_BIN=dreamina-canvas
