{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "programId",
    "programForm",
    "explainerType",
    "seriesTitle",
    "audience",
    "editorialDirection",
    "viewerBenefit",
    "narrativeTone",
    "seriesFramework",
    "visualPackage", "coverPackage", "openerTemplate",
    "episodes"
  ],
  "properties": {
    "referenceProgram": {
      "type": "object", "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "schemaVersion": {"const": "7.3"},
    "programId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "programForm": {"const": "historical-explainer"},
    "explainerType": {"description": "P0 determines the programme-wide writing route; an explicit user choice takes precedence.", "enum": ["general", "current-affairs"]},
    "seriesTitle": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "editorialDirection": {"type": "string", "minLength": 1},
    "viewerBenefit": {"type": "string", "minLength": 1},
    "narrativeTone": {"type": "string", "minLength": 1},
    "seriesFramework": {"type": "string", "minLength": 1},
    "maxDurationSeconds": {"type": "integer", "minimum": 1},
    "openerTemplate": {"description": "Programme-wide opener template ID, independent of programme form. P0 chooses from the current opener catalog.", "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "visualPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualPackageId", "version"],
      "properties": {
        "visualPackageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "coverPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverPackageId", "version"],
      "properties": {
        "coverPackageId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "researchLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notebookId", "requiredSourceIds"],
      "properties": {
        "notebookId": {"type": "string", "minLength": 1},
        "requiredSourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "baseBookSourceId": {"type": "string", "minLength": 1}
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episodeId",
          "episodeTitle",
          "episodeQuestion",
          "episodeAnswer",
          "episodeCreativeBrief",
          "episodeScope",
          "episodeBenefit"
        ],
        "properties": {
          "episodeId": {"type": "string", "pattern": "^ep[0-9]{2,}$"},
          "referenceVideoIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "episodeTitle": {"type": "string", "minLength": 1, "maxLength": 30},
          "episodeQuestion": {"type": "string", "minLength": 1},
          "episodeAnswer": {"type": "string", "minLength": 1},
          "episodeCreativeBrief": {"type": "string", "minLength": 1},
          "episodeScope": {"type": "string", "minLength": 1},
          "episodeBenefit": {"type": "string", "minLength": 1}
        }
      }
    },
    "_producer": {"$ref": "#/$defs/producer"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "nodeId", "taskDigest", "inputs", "rules", "contract", "outputSha256"],
      "properties": {
        "moduleId": {"type": "string", "minLength": 1},
        "nodeId": {"type": "string", "minLength": 1},
        "taskDigest": {"$ref": "#/$defs/sha"},
        "inputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha"},
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha"},
          "uniqueItems": true
        },
        "contract": {"$ref": "#/$defs/sha"},
        "outputSha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
