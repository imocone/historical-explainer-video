{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direct episode visual plan candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["albumPlan", "beats", "templateRuns"],
  "properties": {
    "albumPlan": {"$ref": "#/$defs/albumPlan"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/beat"}
    },
    "templateRuns": {
      "type": "array",
      "items": {"$ref": "#/$defs/templateRun"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "cueRange": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "beatRef": {"type": "string", "pattern": "^B[0-9]{3}$"},
    "templateId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "albumPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "openingState", "progression", "endingState", "recurringElements"],
      "properties": {
        "intent": {"$ref": "#/$defs/text"},
        "openingState": {"$ref": "#/$defs/text"},
        "progression": {"$ref": "#/$defs/text"},
        "endingState": {"$ref": "#/$defs/text"},
        "recurringElements": {
          "type": "array",
          "items": {"$ref": "#/$defs/recurringElement"}
        }
      }
    },
    "recurringElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "purpose", "progression", "beatRefs"],
      "properties": {
        "id": {"type": "string", "pattern": "^RE[0-9]{3}$"},
        "subject": {"$ref": "#/$defs/text"},
        "purpose": {"$ref": "#/$defs/text"},
        "progression": {"$ref": "#/$defs/text"},
        "beatRefs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/beatRef"}
        }
      }
    },
    "directorBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleInAlbum", "mustShow", "relationFromPrevious"],
      "properties": {
        "roleInAlbum": {"$ref": "#/$defs/text"},
        "mustShow": {"$ref": "#/$defs/text"},
        "relationFromPrevious": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/text"}
          ]
        }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cueRange", "viewerOutcome", "directorBrief", "templateId"],
      "properties": {
        "id": {"type": "string", "pattern": "^B[0-9]{3}$"},
        "cueRange": {"$ref": "#/$defs/cueRange"},
        "viewerOutcome": {"$ref": "#/$defs/text"},
        "directorBrief": {"$ref": "#/$defs/directorBrief"},
        "templateId": {"$ref": "#/$defs/templateId"}
      }
    },
    "templateRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "templateId", "beatIds"],
      "properties": {
        "id": {"type": "string", "pattern": "^TR[0-9]{3}$"},
        "templateId": {"$ref": "#/$defs/templateId"},
        "beatIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/beatRef"}
        }
      }
    }
  }
}
