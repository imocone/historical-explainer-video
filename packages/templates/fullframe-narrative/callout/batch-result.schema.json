{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Author historical quote closeout",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "receipt"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quote"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "quote": {"type": ["object", "null"]}
        }
      }
    },
    "receipt": {"type": "object"}
  }
}
