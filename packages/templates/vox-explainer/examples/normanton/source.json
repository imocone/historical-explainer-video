  "segments": [
    {
      "id": "TR002",
      "name": "map",
      "viewerOutcome": "认清横滨、神户与和歌山大岛附近熊野滩的空间关系，理解船长脱险、日本乘客全亡及社会震惊之间的追责缘由。",
      "directorBrief": {
        "roleInAlbum": "把开场险境发展为有共同地理参照、有身份与结果区别的海难问题。",
        "mustShow": "横滨出发、神户目的地与熊野滩遇险海域的相对地理关系；遇险船、沿岸救援与船长和大部分船员脱险、日本乘客二十五人全亡之间的区别。保留部分英国、印度、中国船员也遇难的限定。口播没有精确航迹或沉船坐标，行程关系不能冒充实测航迹；旁白的“数小时后”不是瞬间沉没。 海难消息传开后的悲痛与震惊，作为本次命运反差的社会后果。",
        "relationFromPrevious": "前段已建立1886年深夜熊野滩风暴；本段补上船的来处、目的地、遇险和人员命运，解释为何要求船长担责。"
      },
      "cues": [
        {
          "id": 3,
          "startMs": 6128,
          "endMs": 11055,
          "text": "一艘从横滨驶往神户的英国货船“诺曼顿号”在风浪中触礁遇险，"
        },
        {
          "id": 4,
          "startMs": 11093,
          "endMs": 12994,
          "text": "并在数小时后沉入大海。"
        },
        {
          "id": 5,
          "startMs": 13564,
          "endMs": 18064,
          "text": "当沿岸渔村的日本村民赶去救援时，眼前是一幅极具反差的景象："
        },
        {
          "id": 6,
          "startMs": 18219,
          "endMs": 22059,
          "text": "英国船长德雷克与大部分船员乘坐救生艇安然脱险。"
        },
        {
          "id": 7,
          "startMs": 22446,
          "endMs": 27101,
          "text": "在撤离混乱中，虽有一名英国船员以及几名印度和中国船员溺水身亡，"
        },
        {
          "id": 8,
          "startMs": 27139,
          "endMs": 29350,
          "text": "并非所有外国船员全数生还；"
        },
        {
          "id": 9,
          "startMs": 29544,
          "endMs": 33966,
          "text": "但最刺眼的事实是，船上搭载的整整二十五名日本乘客，"
        },
        {
          "id": 10,
          "startMs": 34044,
          "endMs": 36991,
          "text": "竟然无一生还，全部随着残破的船体沉入海底。"
        },
        {
          "id": 11,
          "startMs": 37794,
          "endMs": 40122,
          "text": "二十五条本国人命葬送在自家领海，"
        },
        {
          "id": 12,
          "startMs": 40160,
          "endMs": 43535,
          "text": "负有最高指挥职责的外国船长却平安上岸。"
        },
        {
          "id": 13,
          "startMs": 43651,
          "endMs": 48073,
          "text": "消息传开，日本社会瞬间被巨大的悲痛与震惊所笼罩。"
        }
      ],
