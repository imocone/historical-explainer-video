      "moments": [
        {
          "id": "M001",
          "purpose": "同一连续海陆地块建立横滨出发、神户目的地与熊野滩遇险海域。横滨到神户只用文字箭头建立行程关系，不绘制伪精确航迹。",
          "sourceRefs": [
            "C003",
            "SA001",
            "SA002"
          ]
        },
        {
          "id": "M002",
          "purpose": "用数小时后字组与时间线表达经过时间，再让遇险船沉入海面下；不把触礁与沉没压成同一瞬间。",
          "sourceRefs": [
            "C004"
          ]
        },
        {
          "id": "M003",
          "purpose": "从原遇险海域展开近岸情境，村民由沿岸聚落向岸边赶来；保留来源区域的地理联系，情境不声称复原具体村落。",
          "sourceRefs": [
            "C005",
            "SA001"
          ]
        },
        {
          "id": "M004",
          "purpose": "救生艇靠近岸边，船长与船员上岸，用定性队列与标签呈现船长和大部分船员脱险。",
          "sourceRefs": [
            "C006"
          ]
        },
        {
          "id": "M005",
          "purpose": "保留脱险一侧，同时展开船员遇难限定：1名英国船员、数名印度和中国船员；与日本乘客身份分开。",
          "sourceRefs": [
            "C007",
            "C008"
          ]
        },
        {
          "id": "M006",
          "purpose": "从船员类别转到日本乘客，以25个可数形象与25人字组建立全体乘客的数量。",
          "sourceRefs": [
            "C009"
          ]
        },
        {
          "id": "M007",
          "purpose": "同一25人形象下沉、暗淡并保留，生还结果定格0人；数字所指明确为生还者，不把乘客总数改成零。",
          "sourceRefs": [
            "C010"
          ]
        },
        {
          "id": "M008",
          "purpose": "把海难结果重新并置：25条本国人命葬送在自家领海，负最高指挥职责的船长平安上岸；以同一船长形象承接对照。",
          "sourceRefs": [
            "C011",
            "C012"
          ]
        },
        {
          "id": "M009",
          "purpose": "海难消息展开为纸面传播与悲痛、震惊两层反应，底部25道痕迹保留人命代价，承接后续追责问题。",
          "sourceRefs": [
            "C013"
          ]
        }
      ],
