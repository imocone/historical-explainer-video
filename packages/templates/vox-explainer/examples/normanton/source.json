      "moments": [
        {
          "id": "M001",
          "purpose": "先建立通常的本国追责期待，海难案卷连接警察、检察官和法院。",
          "sourceRefs": [
            "C014",
            "C015"
          ]
        },
        {
          "id": "M002",
          "purpose": "调查与起诉沿同一案件展开，建立程序中的不同职责。",
          "sourceRefs": [
            "C016"
          ]
        },
        {
          "id": "M003",
          "purpose": "把案件性质保持为待查问题，法院承担查明责任的期待。",
          "sourceRefs": [
            "C017"
          ]
        },
        {
          "id": "M004",
          "purpose": "保留同一组司法机关，切回1886年日本的实际处境。",
          "sourceRefs": [
            "C018"
          ]
        },
        {
          "id": "M005",
          "purpose": "拘传令示意纸上出现否定笔划，说明对英国船长的权限缺失。",
          "sourceRefs": [
            "C019"
          ]
        },
        {
          "id": "M006",
          "purpose": "依次撤掉逮捕、起诉、审理的权限，区分机关与权限。",
          "sourceRefs": [
            "C020"
          ]
        },
        {
          "id": "M007",
          "purpose": "保留日本方面的追责要求，明确受限并非推卸责任。",
          "sourceRefs": [
            "C021"
          ]
        },
        {
          "id": "M008",
          "purpose": "把受限的三条路径归结到领事裁判权这一制度安排。",
          "sourceRefs": [
            "C022"
          ]
        },
        {
          "id": "M009",
          "purpose": "沿年份尺向过去回溯，把1886年海难与幕末条约连接。",
          "sourceRefs": [
            "C023"
          ]
        },
        {
          "id": "M010",
          "purpose": "展开1858年安政条约示意，交代幕府与列强的安排。",
          "sourceRefs": [
            "C024"
          ]
        },
        {
          "id": "M011",
          "purpose": "条约纸页展开领事裁判权，并标明治外法权这一称呼。",
          "sourceRefs": [
            "C025"
          ]
        },
        {
          "id": "M012",
          "purpose": "从条约返回同一案件，先固定案发地点在日本境内。",
          "sourceRefs": [
            "C026"
          ]
        },
        {
          "id": "M013",
          "purpose": "英国臣民身份与日本本国法庭并列，显示日本无刑事管辖权。",
          "sourceRefs": [
            "C027"
          ]
        },
        {
          "id": "M014",
          "purpose": "案卷改道至同在日本的英国领事法庭，再接上英国法律。",
          "sourceRefs": [
            "C028"
          ]
        },
        {
          "id": "M015",
          "purpose": "把完整管辖图短暂收回公文名词，再展开它在本国领土上的作用。",
          "sourceRefs": [
            "C029",
            "C030"
          ]
        },
        {
          "id": "M016",
