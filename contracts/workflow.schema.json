{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subjectKind", "stages", "nodes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "subjectKind": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "stages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^p[0-9]+$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "moduleId", "scope", "condition"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "after": {
            "oneOf": [
              {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
              }
            ]
          },
          "afterEach": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "moduleId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "scope": {"enum": ["subject", "each-beat", "each-author-unit", "opener"]},
          "condition": {"enum": ["always", "video-enabled", "input-present", "slot-filled", "historical-explainer", "historical-documentary"]}
        },
        "allOf": [
          {"not": {"required": ["after", "afterEach"], "properties": {"after": {}, "afterEach": {}}}},
          {
            "if": {"properties": {"condition": {"const": "input-present"}}, "required": ["condition"]},
            "then": {"properties": {"scope": {"const": "opener"}}}
          }
        ]
      }
    }
  }
}
