{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "episodeId",
    "targetId",
    "platforms",
    "covers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "7.0"
    },
    "episodeId": {
      "$ref": "#/$defs/id"
    },
    "targetId": {
      "const": "release-main"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "youtube",
        "douyin",
        "xiaohongshu"
      ],
      "properties": {
        "youtube": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "tags"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "tags": {
              "type": "array",
              "minItems": 0,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "uniqueItems": true
            },
            "chapters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "startText"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "startText": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": "作者选定章名与本章起始正文原句；时间由成片字幕投影，随youtube.description一同修订。"
              },
              "description": "适合分章的长视频交付至少三章，首章从正文开头起；短视频或单一内容可省略或为空。"
            }
          }
        },
        "douyin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "body",
            "topics"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "topics": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20,
                "pattern": "^[^#]+$"
              },
              "uniqueItems": true
            }
          }
        },
        "xiaohongshu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "body",
            "topics"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            },
            "topics": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20,
                "pattern": "^[^#]+$"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "covers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "youtube",
        "vertical"
      ],
      "properties": {
        "youtube": {
          "$ref": "#/$defs/cover"
        },
        "vertical": {
          "$ref": "#/$defs/cover"
        }
      }
    },
    "coverReuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselinePublicationSha256"
      ],
      "properties": {
        "baselinePublicationSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "coverTextEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselinePublicationSha256",
        "sources"
      ],
      "properties": {
        "baselinePublicationSha256": {
          "$ref": "#/$defs/sha"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "youtube": {
              "$ref": "#/$defs/sha"
            },
            "vertical": {
              "$ref": "#/$defs/sha"
            }
          }
        }
      }
    },
    "_producer": {
      "$ref": "#/$defs/producer"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posterConcept",
        "heroVisual",
        "visibleText"
      ],
      "properties": {
        "posterConcept": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "heroVisual": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "visibleText": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "按希望的阅读顺序交付1至3项精确原文；不规定主句拆分或系列名，横竖可分别措辞。"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "nodeId",
        "taskDigest",
        "inputs",
        "rules",
        "contract",
        "outputSha256",
        "materialExecutionId"
      ],
      "properties": {
        "moduleId": {
          "enum": [
            "author-narration",
            "author-documentary-narration"
          ]
        },
        "nodeId": {
          "enum": [
            "author-narration",
            "author-documentary-narration"
          ]
        },
        "taskDigest": {
          "$ref": "#/$defs/sha"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha"
          },
          "uniqueItems": true
        },
        "contract": {
          "$ref": "#/$defs/sha"
        },
        "outputSha256": {
          "$ref": "#/$defs/sha"
        },
        "materialExecutionId": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  }
}
