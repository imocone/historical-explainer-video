{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["episodeId", "visualPackage", "renderDigest", "renderPlanSha256", "renderPlanDurationMs", "output", "sha256", "durationMs", "video", "audio", "_producer"],
  "properties": {
    "mediaRetention": {"const": "documents-and-release"},
    "episodeId": {"type": "string"},
    "visualPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "renderDigest": {"$ref": "#/$defs/sha"},
    "renderPlanSha256": {"$ref": "#/$defs/sha"},
    "output": {"$ref": "#/$defs/path"},
    "sha256": {"$ref": "#/$defs/sha"},
    "renderPlanDurationMs": {"type": "integer", "minimum": 1},
    "durationMs": {"type": "integer", "minimum": 1},
    "video": {"type": "object", "additionalProperties": false, "required": ["codec", "width", "height", "fps", "pixelFormat", "colorRange", "colorSpace", "colorTransfer", "colorPrimaries"], "properties": {"codec": {"type": "string", "minLength": 1}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "fps": {"type": "number", "exclusiveMinimum": 0}, "pixelFormat": {"type": "string", "minLength": 1}, "colorRange": {"type": "string", "minLength": 1}, "colorSpace": {"type": "string", "minLength": 1}, "colorTransfer": {"type": "string", "minLength": 1}, "colorPrimaries": {"type": "string", "minLength": 1}}},
    "audio": {"type": "object", "additionalProperties": false, "required": ["codec", "sampleRate", "channels"], "properties": {"codec": {"type": "string", "minLength": 1}, "sampleRate": {"type": "integer", "minimum": 1}, "channels": {"type": "integer", "minimum": 1}}},
    "_producer": {"$ref": "#/$defs/programProducer"},
    "publicationTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captions"
      ],
      "properties": {
        "captions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "startMs",
              "endMs"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "startMs": {
                "type": "number",
                "minimum": 0
              },
              "endMs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "programProducer": {"type": "object", "additionalProperties": false, "required": ["moduleId", "nodeId", "taskDigest", "inputs", "outputSha256"], "properties": {"moduleId": {"type": "string"}, "nodeId": {"type": "string"}, "taskDigest": {"$ref": "#/$defs/sha"}, "inputs": {"type": "array", "items": {"$ref": "#/$defs/sha"}, "uniqueItems": true}, "outputSha256": {"$ref": "#/$defs/sha"}}}
  }
}
