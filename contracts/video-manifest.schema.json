{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episodeId",
    "videoPlanSha256",
    "clips"
  ],
  "properties": {
    "episodeId": {
      "type": "string",
      "pattern": "^ep[0-9]{2,}$"
    },
    "videoPlanSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "clips": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requestDigest",
          "firstFrameSha256",
          "file",
          "sha256",
          "width",
          "height",
          "durationMs",
          "parts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V[0-9]{3}$"
          },
          "requestDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "firstFrameSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "const": 1920
          },
          "height": {
            "const": 1080
          },
          "durationMs": {
            "type": "integer",
            "minimum": 4000
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "firstFrame",
              "motion",
              "ending",
              "join"
            ],
            "properties": {
              "firstFrame": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "motion": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "ending": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "join": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "requestDigest",
                "firstFrameSha256",
                "submitId",
                "file",
                "sha256",
                "frameCount",
                "sourceSha256",
                "editDigest",
                "cuts"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 1
                },
                "requestDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "firstFrameSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "submitId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "frameCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 900
                },
                "sourceSha256": {
                  "$ref": "#/$defs/sha"
                },
                "editDigest": {
                  "$ref": "#/$defs/sha"
                },
                "cuts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "shotId",
                      "sourceStartFrame",
                      "sourceEndFrame"
                    ],
                    "properties": {
                      "shotId": {
                        "type": "string",
                        "pattern": "^S[0-9]{2}$"
                      },
                      "sourceStartFrame": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sourceEndFrame": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "60fps剪辑时间轴的排他结束帧，选择范围为[start,end)；原片在剪接时换算。"
                      }
                    }
                  }
                }
              }
            }
          },
          "firstFrame": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "sha256",
              "parentSha256",
              "edit"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha"
              },
              "parentSha256": {
                "$ref": "#/$defs/sha"
              },
              "edit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "_producer": {
      "$ref": "#/$defs/producer"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "nodeId",
        "taskDigest",
        "inputs",
        "rules",
        "contract",
        "outputSha256"
      ],
      "properties": {
        "moduleId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "taskDigest": {
          "$ref": "#/$defs/sha"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha"
          },
          "uniqueItems": true
        },
        "contract": {
          "$ref": "#/$defs/sha"
        },
        "outputSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  }
}
